# ==========================================
# AURAGEN MONOREPO — ENVIRONMENT TEMPLATE
# ==========================================

# --- Backend Server (apps/server) ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Neon PostgreSQL (Backend ONLY — NEVER expose to Next.js client) ---
# Pooled connection string for runtime queries (-pooler hostname)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/auragen?sslmode=require
# Direct connection string for Drizzle Kit migrations
DIRECT_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/auragen?sslmode=require

# --- Frontend Web App (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# --- Day 8: Google Gemini AI via Google AI Studio (Backend ONLY — NEVER expose to Next.js) ---
GOOGLE_API_KEY=AQ.Ab8RN6K1oIrpUkL3jyEDnm517CxLoG_p4M7aLUpReL2OnYsE2g
GEMINI_MODEL=gemini-2.5-flash