{
  "name": "auragen",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test:friction": "npm run test:friction -w @auragen/web",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "npm run prisma:generate -w @auragen/api",
    "db:migrate": "npm run prisma:migrate -w @auragen/api",
    "db:deploy": "npm run prisma:deploy -w @auragen/api",
    "db:validate": "npm run prisma:validate -w @auragen/api",
    "db:verify": "npm run db:verify -w @auragen/api"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
